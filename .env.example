# ── Data backend ─────────────────────────────────────────────
# Options: excel | postgres | sap
DATA_BACKEND=excel
# Set a long random key before exposing the upload API beyond localhost.
SPI_UPLOAD_API_KEY=

# ── PostgreSQL (when DATA_BACKEND=postgres) ───────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=spare_parts
POSTGRES_USER=yamaha_rw
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSLMODE=require

# ── SAP (when DATA_BACKEND=sap) ───────────────────────────────
SAP_ASHOST=
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWORD=CHANGE_ME
SAP_LANG=EN

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=./mlruns

# ── Application ───────────────────────────────────────────────
LOG_LEVEL=INFO
TIMEZONE=Asia/Colombo
CURRENCY=LKR
SERVICE_LEVEL=0.95
LEAD_TIME_DAYS=90

# Advance this only when a new month-end current_stock.xlsx snapshot is supplied.
SPI_STOCK_SNAPSHOT_AS_OF=2026-09-30
# The owner confirmed the dated On_Orders.xlsx contains the complete open-PO list.
SPI_ON_ORDERS_VERIFIED_COMPLETE=true
